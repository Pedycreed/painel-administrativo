# Copie este arquivo pra `.env` e preencha com os valores reais.
# NUNCA commit o `.env` no Git.

# ============================================================
# Banco de Dados (Postgres)
# ============================================================
# Local SQLite: deixe em branco que o Django usa db.sqlite3
# Produção: cole a connection string do Neon (neon.tech) ou outro Postgres.
# Formato: postgresql://USER:PASS@HOST/DBNAME?sslmode=require
DATABASE_URL=

# ============================================================
# Cloudflare R2 (storage de imagens)
# ============================================================
# Painel: https://dash.cloudflare.com → R2
#   - Account ID: aparece no topo da página R2
#   - Access key e secret: R2 → Manage R2 API Tokens → Create API Token
#   - Bucket: nome que você escolheu ao criar
#   - Public URL: R2 → bucket → Settings → Public Access → pub-xxx.r2.dev
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mangapanel
R2_PUBLIC_URL=

# Apenas dev local no Windows com Python 3.13: 1 = ignora verificação TLS.
# NÃO LIGAR EM PRODUÇÃO.
R2_SKIP_TLS_VERIFY=0

# ============================================================
# Django
# ============================================================
# Em produção: False sempre. Em dev local: True.
DJANGO_DEBUG=True

# Gere uma chave nova pra produção com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=insegura-troque-em-prod

# Hosts separados por vírgula. Em prod: domínio do Railway (ex: painelex.up.railway.app)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origens do frontend pro CORS. Em prod: domínio do Vercel.
# Ex: https://painelex.vercel.app,https://meusite.com
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Origens confiáveis pro CSRF. Em prod: mesma coisa que CORS + URL do Railway.
# Ex: https://painelex.vercel.app,https://painelex.up.railway.app
DJANGO_CSRF_TRUSTED_ORIGINS=
